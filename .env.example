# Variables de entorno para desarrollo local.
# En Railway NO necesitas crear estas: usa Variable References al plugin de MySQL.

PORT=3000
JWT_SECRET=cambia_esta_clave_por_una_segura

# Opción A: variables individuales
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=restaurante_db

# Opción B: Railway expone automáticamente estas al añadir MySQL:
# MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE
# o bien una URL completa:
# MYSQL_URL=mysql://user:pass@host:port/database
